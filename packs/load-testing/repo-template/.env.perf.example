# Configuración de la compuerta de rendimiento.
#
# Copia este archivo a .env.perf y ajústalo. NO lo comitees con secretos:
# .env.perf debe estar en .gitignore. Los secretos de CI van en los secretos del
# repositorio, no aquí.
#
#   cp .env.perf.example .env.perf
#   set -a && . ./.env.perf && set +a
#   bin/perf-check smoke
#
# IMPORTANTE: entrecomilla todo valor que contenga espacios. Este archivo se lee
# con `source`, así que PERF_APP_MARKER=Cargar precios hace que el shell intente
# ejecutar "precios" como un comando y la variable queda a medias.

# ---------------------------------------------------------------------------
# Obligatorio
# ---------------------------------------------------------------------------

# URL base del objetivo, con esquema y sin barra final.
PERF_TARGET=http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Tipo de objetivo
# ---------------------------------------------------------------------------

# none          Sin autenticación de plataforma (local, API pública).
# supabase      La APLICACIÓN exige sesión de usuario final (ver más abajo).
# vercel-bypass Preview de Vercel con Deployment Protection.
# iap           Cloud Run detrás de Identity-Aware Proxy.
# bearer        Token propio de la aplicación.
PERF_AUTH=none

# Texto que sólo existe en tu aplicación. OBLIGATORIO cuando PERF_AUTH no es
# "none": es lo único que distingue tu aplicación de la pantalla de login de la
# plataforma, porque ambas responden 200 con HTML.
#
# Elige algo estable: un id de contenedor, el nombre del producto en el título.
# No elijas un texto que cambia en cada despliegue.
# Entre comillas si lleva espacios: PERF_APP_MARKER="Cargar precios"
PERF_APP_MARKER=

# Ruta canónica que verifica el guard. Debe ser una ruta FINAL, no una que
# redirija.
PERF_GUARD_PATH=/

# Rutas a medir. "GET /,GET /api/records" o simplemente "/,/api/records".
PERF_ROUTES=/

# ---------------------------------------------------------------------------
# Umbrales
# ---------------------------------------------------------------------------

# Límite de latencia p(95) en milisegundos.
PERF_P95_MS=1500

# Tasa de error HTTP tolerada (0.01 = 1 %).
PERF_ERROR_RATE=0.01

# Degradación tolerada frente a la línea base aprobada, en por ciento.
PERF_DRIFT_PCT=25

# Iteraciones del perfil smoke.
PERF_SMOKE_ITERATIONS=5

# ---------------------------------------------------------------------------
# Perfil de carga (sólo para bin/perf-check load)
# ---------------------------------------------------------------------------

PERF_PEAK_VUS=10
PERF_RAMP=30s
PERF_HOLD=1m

# ---------------------------------------------------------------------------
# Credenciales — nunca las comitees
# ---------------------------------------------------------------------------

# PERF_AUTH=vercel-bypass
# Vercel > Project > Settings > Deployment Protection > Protection Bypass for Automation
# VERCEL_AUTOMATION_BYPASS_SECRET=

# PERF_AUTH=iap
# Genérala justo antes de correr; expira en ~1 hora. El audience es el client ID
# de OAuth de IAP, NO la URL del servicio:
#   export PERF_IAP_TOKEN="$(gcloud auth print-identity-token --audiences=CLIENT_ID)"
# PERF_IAP_TOKEN=

# PERF_AUTH=bearer
# PERF_BEARER=

# PERF_AUTH=supabase — sesión de usuario final.
# Usa siempre un usuario de PRUEBA con datos de prueba: la prueba de carga hace
# cientos de peticiones autenticadas como ese usuario.
# PERF_SUPABASE_URL=https://<ref>.supabase.co
# PERF_SUPABASE_ANON_KEY=       # pública por diseño (NEXT_PUBLIC_*)
# PERF_USER_EMAIL=
# PERF_USER_PASSWORD=
