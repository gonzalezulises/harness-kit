 "$HEAD_SHA"\n            printf \'| base_sha | `%s` |\\n\' "$BASE_SHA"\n            printf \'| workflow_sha | `%s` |\\n\' "$WORKFLOW_SHA"\n            printf \'| run | `%s` (attempt %s) |\\n\' "$RUN_ID" "$RUN_ATTEMPT"\n            printf \'| shellcheck | `%s` |\\n\' "$LINT_OUTCOME"\n            printf \'| gherkin pack | `%s` |\\n\' "$GHERKIN_OUTCOME"\n            printf \'| make check | `%s` (exit `%s`) |\\n\' "$CHECK_OUTCOME" "${CHECK_EXIT:-none}"\n            printf \'| verify-claims | `%s` (exit `%s`) |\\n\' "$CLAIMS_OUTCOME" "${CLAIMS_EXIT:-none}"\n            printf \'| verify-decisions | `%s` (exit `%s`) |\\n\' "$DECISIONS_OUTCOME" "${DECISIONS_EXIT:-none}"\n            printf \'| conclusion | `%s` |\\n\' "$conclusion"\n          } >> "$GITHUB_STEP_SUMMARY"\n\n          if [ "$conclusion" != success ]; then\n            printf \'Required quality conclusion is non-success: %s\\n\' "$conclusion" >&2\n            exit 1\n          fi\n'

