{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record.v1 typed domain value (after YAML parsing)",
  "type": "object", "additionalProperties": false,
  "required": ["title", "status", "enabled", "threshold"],
  "properties": {
    "title": {"type": "string"},
    "status": {"enum": ["active", "paused"]},
    "enabled": {"type": "boolean"},
    "threshold": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "lexeme"],
      "properties": {
        "type": {"const": "number"},
        "lexeme": {"type": "string", "pattern": "^[+-]?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"}
      }
    }
  }
}
